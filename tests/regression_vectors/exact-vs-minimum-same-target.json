{
  "title": "The same restored count can fail exact and pass minimum",
  "args": [
    "--expect-rows",
    "labels=5",
    "--expect-rows-at-least",
    "labels=5"
  ],
  "catalog": {
    "public.labels": {
      "kind": "r",
      "rows": 6
    }
  },
  "queries": [
    [
      "public.labels"
    ],
    [
      "public.labels",
      6
    ],
    [
      "public.labels"
    ],
    [
      "public.labels",
      5
    ]
  ],
  "exit": 1,
  "json": {
    "status": "fail",
